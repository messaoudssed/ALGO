PROCEDURE DOT_PRODUCT(v1 : ARRAY OF REAL, v2 : ARRAY OF REAL, OUT ps : REAL)
VAR
    i : INTEGER := 0;
BEGIN
    ps := 0;
    FOR i FROM 0 TO LENGTH(v1) - 1 DO
        ps := ps + v1[i] * v2[i];
    END_FOR
END_PROCEDURE

ALGORITHM VECTEURS_ORTHOGONAUX
VAR
    vecteurs1, vecteurs2 : ARRAY[1..3] OF ARRAY OF REAL := 
        [[1,2], [3,4], [0,5]], [[-2,1], [1,2], [0,0]];
    i : INTEGER := 0;
    ps : REAL;
BEGIN
    FOR i FROM 1 TO 3 DO
        CALL DOT_PRODUCT(vecteurs1[i], vecteurs2[i], ps);
        IF ps = 0 THEN
            Write("Les vecteurs ", i, " sont orthogonaux.");
        ELSE
            Write("Les vecteurs ", i, " ne sont pas orthogonaux.");
        END_IF
    END_FOR
END_ALGORITHM
